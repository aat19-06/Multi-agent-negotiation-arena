# Environment ? copy to .env and fill in your values

# === Database ===
# Local development defaults to SQLite unless you explicitly configure PostgreSQL.
POSTGRES_USER=negotiation
POSTGRES_PASSWORD=negotiation_secret
POSTGRES_DB=negotiation_arena
DATABASE_URL=sqlite+aiosqlite:///./negotiation_arena.db
# If you want to use Docker/Postgres instead, set DATABASE_URL=postgresql+asyncpg://negotiation:negotiation_secret@localhost:5432/negotiation_arena

# === Security ===
SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# === Groq AI ===
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=llama-3.3-70b-versatile

# === Agent Mode ===
# Set to false to use real Groq LLM agents
USE_MOCK_AGENTS=true

# === CORS ===
FRONTEND_URL=http://localhost:5173

# === App ===
ENVIRONMENT=development
LOG_LEVEL=INFO
