# Copy to .env and fill in your local values. Never commit .env.

# PostgreSQL for Docker Compose. Set a unique local password before running Compose.
POSTGRES_USER=negotiation
POSTGRES_PASSWORD=
POSTGRES_DB=negotiation_arena

# Standalone backend development uses SQLite; Compose overrides this with its PostgreSQL service.
DATABASE_URL=sqlite+aiosqlite:///./negotiation_arena.db
USE_SQLITE_FALLBACK=true

# Development-only placeholder. Replace with a unique random value in production.
SECRET_KEY=replace-with-a-unique-random-secret-at-least-32-characters
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# Optional; USE_MOCK_AGENTS=true requires no API key and uses no external AI service.
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=llama-3.3-70b-versatile
USE_MOCK_AGENTS=true

# Local frontend origin.
FRONTEND_URL=http://localhost:5173

ENVIRONMENT=development
LOG_LEVEL=INFO
